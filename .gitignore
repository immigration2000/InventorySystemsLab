# Unreal Engine generated files; keep the project/module named Project.
/Project/Binaries/
/Project/Intermediate/
/Project/Saved/
/Project/DerivedDataCache/
/Project/.vs/
/Project/.idea/

# Generated IDE files; keep .vsconfig, .uproject, Config, Source and Content.
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.code-workspace

# Preserve binary-only plugin Binaries.
/Project/Plugins/**/Intermediate/
/Project/Plugins/**/Saved/
/Project/Plugins/**/DerivedDataCache/

# Preserve Build resources and platform configuration.
/Project/Build/**/FileOpenOrder/
/Project/Content/Developers/
/Project/Content/Collections/

.DS_Store
Thumbs.db
Desktop.ini
*.stackdump
